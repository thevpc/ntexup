<!--                <groupId>org.apache.maven.plugins</groupId>-->
<!--                <artifactId>maven-enforcer-plugin</artifactId>-->
<!--                <version>3.5.0</version>-->
<!--                <executions>-->
<!--                    <execution>-->
<!--                        <id>enforce-build-environment</id>-->
<!--                        <goals><goal>enforce</goal></goals>-->
<!--                        <configuration>-->
<!--                            <rules>-->
<!--                                <requireJavaVersion><version>[17,18)</version></requireJavaVersion>-->
<!--                                <requireMavenVersion><version>[3.9.0,4)</version></requireMavenVersion>-->
<!--                            </rules>-->
<!--                        </configuration>-->
<!--                    </execution>-->
<!--                </executions>-->
<!--            </plugin>-->
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>thevpc</id>
            <url>https://maven.thevpc.net</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </pluginRepository>
        <pluginRepository>
            <id>thevpc</id>
            <url>https://maven.thevpc.net</url>
        </pluginRepository>
    </pluginRepositories>
    <modules>
        <module>core/ntexup-api</module>
        <module>core/ntexup-engine</module>
        <module>test/ntexup-examples</module>
        <module>lib/ntexup-lib-geometry2d</module>
        <module>lib/ntexup-lib-geometry3d</module>
        <module>extensions/ntexup-extension-plantuml</module>
        <module>extensions/ntexup-extension-animated-gif</module>
        <module>extensions/ntexup-extension-svg</module>
        <module>extensions/ntexup-extension-shapes2d</module>
        <module>extensions/ntexup-extension-shapes3d</module>
        <module>extensions/ntexup-extension-plot2d</module>
        <module>extensions/ntexup-extension-latex</module>
        <module>extensions/ntexup-extension-presenters</module>
        <module>extensions/ntexup-extension-common-functions</module>
        <module>tutorials/ntexup-extension-tutorial-myshape</module>
        <module>companions/nscoreboard</module>
        <module>renderers/ntexup-renderer-pdf</module>
        <module>renderers/ntexup-renderer-html</module>
        <module>renderers/ntexup-renderer-screen</module>
        <module>renderers/ntexup-renderer-web</module>
        <module>app/ntexup</module>
        <module>app/ntexup-viewer-backend</module>
        <module>ntexup-full</module>
    </modules>
</project>
