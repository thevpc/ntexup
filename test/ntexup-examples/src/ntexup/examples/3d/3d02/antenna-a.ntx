

page{
    styles:{
        text:{
            color:darkBlue
        }
        line:{
            color:black
        }
        .dimLine:{
            start-arrow:simple()
            end-arrow:simple()
            stroke:basic(dashed)
        }
        .dimLabel:{
            origin:(50,50)
        }
    }
        rectangle(background:white)
        scene3d(
            draw-contour,
                transform:{
//                    rotate(from:(0,0,0),to:(100,0,0),angle:-30)
                    translate(10,10,0)
                    scale:0.7
                }
        ){
            box(size:(100,100,1),position:(0,0,-5), background:"#cb6d51")

            box(size:(100,100,4),position:(0,0,-4)
                , background:"#00468B"
                , mesh-precision: 1000
//                ,faces:{
//                    top:{background:pink,visible:true} // back
//                    bottom:{background:CadetBlue,visible:true} // front
                    left:{background:dark-blue,visible:true} // left
                    right:{background:dark-blue,visible:true} // right
                    front:{background:dark-blue,visible:true} // bottom
                    back:{background:dark-blue,visible:true} // top
//                }
            ) // substrate
            box(size:(30,10,2),position:(5,45,2), background:"#cb6d51") // line
            box(size:(50,50,2),position:(35,25,2), background:"#cb6d51") // patch
            box(size:(5,10,2),position:(0,45,2), background:yellow) // source
        }

//        @dimLabel text("w", font-size:3%P , position:(16,31))
