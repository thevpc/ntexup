page{
    styles:{
        text:{
            color:darkBlue
        }
        line:{
            color:black
        }
        .dielectric:{
            background:black
        }
        .dimLine:{
            start-arrow:simple()
            end-arrow:simple()
            stroke:basic(dashed)
        }
        .dimension:{
            color:black
            arrow:simple()
            stroke:dashed
            label-position:center
            label-orientation:screen
        }
    }
        rectangle(background:white)
        scene3d(
            draw-contour,
                transform:{
                    translate(10,10,0)
                    scale:0.7
                }
        ){
            @dielectric box(size:(100,100,5),position:(0,0,-5))
            @dimension line(from:(-5,0,-5),to:(-5,100,-5),label:{"hello",offset:(-5,0)})

