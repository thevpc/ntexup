import(
    common-functions
    plantuml
    animated-gif
    svg
    shapes2d
    shapes3d
    plot2d
    presenters
    latex
    hadruwaves
)

// --- Antenna Parameters (2.4 GHz on FR-4) ---
f  = 2.4GHz
εr = 4.4
h  = 1.6mm
h0  = 0.1mm

// --- Antenna Parameters (2.4 GHz on FR-4) ---
W  = 38.0mm   // Now the dimension along Y
L  = 29.45mm  // Now the dimension along X (radiating dimension)
w  = 3.05mm   // Feed Line Width (now a Y-dimension)
y0 = 9.3mm    // Inset Depth (now along X)
att= 1.3mm    // Attach needed for MoM
g  = 1.0mm    // Gap width
s  = 1.0mm    // Source width

// Box/Substrate dimensions
box_w = 80mm
box_l = 200mm


az  = 0.01mm    // z offset to draw arrows

page(bg:Gray90){
    styles:{
        text:{ color:darkBlue }
        line:{ color:black }
        ".substrate":{ bg:gray80 }
        ".antenna":{ bg:copper }
        ".patch":{ bg:copper }
        ".feedline":{ bg:copper }
        ".attachment":{ bg:red }
        ".source":{ bg:yellow }
        ".dim-arrow":{
            arrow: simple()
            stroke: basic(dashed)
            line-color:darkBlue
        }
    }
        scene3d(
            name: "antenna-a"
            draw-contour,
            transform:{
                translate(0,20,0)
                scale:0.9
            },
            real-size:(box_w,box_l,20mm)
            real-position:(-(box_w/2),-(box_l/2),0mm)
            size:(100,100) // 100% of the allocated 2D area from parent, aka all of it
            origin:(0,0)
        ){
            // 1. Substrate & Ground
            @(substrate) box(size: (box_w, box_l, h) , position: (-(box_w/2), -(box_l/2), -h))
            @(ground)    box(size: (box_w, box_l, h0), position: (-(box_w/2), -(box_l/2), -h -h0))

            // 2. The Inset-Fed Patch
            @(patch)   polygon(
                points: [
                        (-(box_w/2)+y0, -W/2, 0mm), (-(box_w/2)+L+y0,  -W/2, 0mm),
                        (-(box_w/2)+L+y0,  W/2, 0mm), ( -(box_w/2)+y0, W/2, 0mm)
                ]
            )
            @(feedline)   box(size:(y0,w,0mm),position:(-(box_w/2),-w/2,0mm))
            @(attachment)   box(size:(att,w,0mm),position:(-(box_w/2)+y0-(att/2),-w/2,0mm))

            // 3. Feeding source
            @(source)    box(size:(s,w,0mm),position:(-(box_w/2),-w/2,0mm))


            // --- Dimension Arrows ---

            // f_l: Feed line length — from substrate edge to patch left edge, below feed line
//            @(dim-arrow) line(from:(-box_w/2, -w/2 - 5mm, az), to:(-box_w/2+L, -w/2 - 5mm, az)) {
//                text("f_l", font-size:2%P, position:(50, 160%))
//            }

        }
}

page{
    hadruwaves-mom-solver(
        name:"hresult"
        geometry:"antenna-a"
        frequency:f
        boundaries:{
            lateral: EEEE
            top: matchedLoad
            bottom: short(material:(permittivity:εr))
        }
        modes:{
            count: 5000
        }
        basis-functions: {
              sinus(geometry:"feedline",     count:1, x:UDxUUy) // Up -> down, along X
              sinus(geometry:"patch",        count:3, x:DDxUUy)
              sinus(geometry:"attachment",   count:1, x:DDxUUy)
        },
        sources:{
            planar(geometry:"source", value:5V, z:50Ω)
        }
        results:{
            allS11:S11(frequency:{from:2.3GHz, to:2.5GHz, count:1})
            mode-functions
            test-functions
            Zmn
            scalar-products
            Jx
            Ex
        }
    )
    plot2d(x:dtimes(-5,5,100)){
        curve{ // supports plot
            f(x):sin(x)
            title:'sin'
        }
    }
//    oemsresult=open-ems-solver(
