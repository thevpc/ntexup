import(
    common-functions
    plantuml
    animated-gif
    svg
    shapes2d
    shapes3d
    plot2d
    presenters
    latex
    hadruwaves
)

// --------------------------------------------------
// Antenna parameters (Synced with openEMS XML)
// --------------------------------------------------

f  = 2.4GHz
εr = 4.4
h  = 1.6mm      // substrate height
h0 = 0.035mm    // copper thickness (e.g., 1oz)

W  = 38.0mm     // patch width (total X is -19 to 19)
L  = 29.4mm     // patch length (total Y is 0 to 29.4)

wf = 3.1mm      // feed width (X is -1.55 to 1.55)
y0 = 10.3mm     // inset depth (Y is 0 to 10.3)
gap = 1.5mm     // inset gap

// Simulation domain (Same as openEMS grid bounds)
box_w = 58mm    // X: -29 to 29
box_l = 59mm    // Y: -20 to 39

feed_y_start = -15mm
feed_y_length = 15mm
port_y_start = -15mm

// --------------------------------------------------
// 3D Geometry
// --------------------------------------------------

page(bg:Gray90){

    styles:{
        ".substrate":{ bg:gray80, opacity: 0.6 }
        ".ground":{ bg:gray50 }
        ".antenna":{ bg:copper }
        ".source":{ bg:yellow }
    }

    scene3d(
        name:"antenna-a",
        draw-contour,
        // Match openEMS Z-span roughly for the scene container
        real-size:(box_w, box_l, 10mm),
        // Aligning origin so Y=0 is the patch bottom entrance
        real-position:(-29mm, -20mm, -h - h0)
        transform:{
            translate(0,20,0)
            scale:0.8
        },
    ){

        // 1. Ground Plane (Z: -1.635 to -1.6)
        @(ground) box(
            size:(box_w, box_l, h0),
            position:(-29mm, -20mm, -h - h0)
        )

        // 2. Substrate (Z: -1.6 to 0)
        @(substrate) box(
            size:(box_w, box_l, h),
            position:(-29mm, -20mm, -h)
        )

        // 3. Patch - Box 1: Left Flank (X: -19 to -3.05, Y: 0 to 10.3)
        @(antenna) @(left-flank) box(
            size:( (W/2) - (wf/2 + gap), y0, h0),
            position:(-19mm, 0mm, 0mm)
        )

        // 4. Patch - Box 2: Right Flank (X: 3.05 to 19, Y: 0 to 10.3)
        @(antenna) @(right-flank) @(right-flank)  box(
            size:( (W/2) - (wf/2 + gap), y0, h0),
            position:( (wf/2 + gap), 0mm, 0mm)
        )

        // 5. Patch - Box 3: Full Width Body (X: -19 to 19, Y: 10.3 to 29.4)
        @(antenna) @(patch) box(
            size:(W, L - y0, h0),
            position:(-19mm, y0, 0mm)
        )

        // 6. Feed Line (X: -1.55 to 1.55, Y: -14 to 10.3)
        // Note: It overlaps with the patch at the connection point y=10.3
        @(antenna) @(feedline) box(
            size:(wf, y0 + 15mm, h0),
            position:(-wf/2, feed_y_start, 0mm)
        )

        // 7. Source / Port (Vertical bridge matching openEMS Excitation)
        // Spans from ground (Z=-1.6) to feed line (Z=0)
        @(source) box(
            size:(wf, 1mm, h0),
            position:(-wf/2, port_y_start, 0mm)
        )
        @(source-extra) box(
            size:(wf, 2mm, h0),
            position:(-wf/2, port_y_start, 0mm)
        )
    }
}

// --------------------------------------------------
// Hadruwaves MoM simulation
// --------------------------------------------------

page{
    hadruwaves-mom-solver(
        name:"hresult"
        geometry:"antenna-a"
        frequency:f
        domain-padding:(75mm,75mm)
        boundaries:{
            lateral:EEEE
            top:matchedLoad
            bottom:short(material:(permittivity:εr))
        }
        modes:{ count:5000 }
        basis-functions:{
//            sinus(geometry:"feedline",     count:2, y:DDxUUy)
//            sinus(geometry:"left-flank",   count:3, y:DDxDUy)
//            sinus(geometry:"right-flank",  count:3, y:DDxDUy)
//            sinus(geometry:"patch",        count:8, y:DDxUDy)

            rwg(geometry:"antenna")
            rwg(geometry:"source-extra")

        }
        sources:{
            planar(geometry:"source", value:5V, z:50Ω)
        }
        results:{
            chronometer
            mesh
            scalar-products
            basis-functions
            mode-functions
            a-matrix
            b-matrix
            allS11:S11(frequency:{from:2.3GHz, to:2.5GHz, count:1})
            Jx
            Jy
        }
    )
}
