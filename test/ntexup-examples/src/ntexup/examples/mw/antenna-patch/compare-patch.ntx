import(
    common-functions
    plantuml
    animated-gif
    svg
    shapes2d
    shapes3d
    plot2d
    presenters
    latex
    hadruwaves
    openems
)

// --------------------------------------------------
// Antenna parameters (Synced with openEMS XML)
// --------------------------------------------------

f  = 2.4GHz
εr = 4.4
h  = 1.6mm      // substrate height
h0 = 0.035mm    // copper thickness

W  = 38.0mm     // patch width (total X is -19 to 19)
L  = 29.4mm     // patch length (total Y is 0 to 29.4)

wf = 3.1mm      // feed width (X is -1.55 to 1.55)
y0 = 10.3mm     // inset depth (Y is 0 to 10.3)
gap = 1.5mm     // inset gap

// Simulation domain
box_w = 58mm    // X: -29 to 29
box_l = 59mm    // Y: -20 to 39

feed_y_start = -15mm
feed_y_length = 15mm
port_y_start = -15mm

// --------------------------------------------------
// 3D Geometry
// --------------------------------------------------

page(bg:Gray90){

    styles:{
        ".substrate":{ bg:gray80, opacity: 0.6 }
        ".ground":{ bg:gray50 }
        ".antenna":{ bg:copper }
        ".source":{ bg:yellow }
    }

    scene3d(
        name:"antenna-patch",
        draw-contour,
        real-size:(box_w, box_l, 10mm),
        real-position:(-29mm, -20mm, -h - h0)
        transform:{
            translate(0,20,0)
            scale:0.8
        },
    ){

        // 1. Ground Plane
        @(ground) box(
            size:(box_w, box_l, h0),
            position:(-29mm, -20mm, -h - h0)
        )

        // 2. Substrate
        @(substrate) box(
            size:(box_w, box_l, h),
            position:(-29mm, -20mm, -h)
        )

        // 3. Patch - Left Flank
        @(antenna) @(left-flank) box(
            size:( (W/2) - (wf/2 + gap), y0, h0),
            position:(-19mm, 0mm, 0mm)
        )

        // 4. Patch - Right Flank
        @(antenna) @(right-flank) box(
            size:( (W/2) - (wf/2 + gap), y0, h0),
            position:( (wf/2 + gap), 0mm, 0mm)
        )

        // 5. Patch - Full Width Body
        @(antenna) @(patch) box(
            size:(W, L - y0, h0),
            position:(-19mm, y0, 0mm)
        )

        // 6. Feed Line
        @(antenna) @(feedline) box(
            size:(wf, y0 + 15mm, h0),
            position:(-wf/2, feed_y_start, 0mm)
        )

        // 7. Source Port
        @(source) box(
            size:(wf, 1mm, h0),
            position:(-wf/2, port_y_start, 0mm)
        )
    }
}

// --------------------------------------------------
// Hadruwaves MoM Simulation
// --------------------------------------------------

page{
    hadruwaves-mom-solver(
        name:"hresult"
        geometry:"antenna-patch"
        frequency:f
        domain-padding:(30mm,30mm)
        boundaries:{
            lateral:EEEE
            top:matchedLoad
            bottom:short(material:(permittivity:εr))
        }
        modes:{ count:1000 }
        basis-functions:{
            rwg(geometry:"antenna")
        }
        sources:{
            planar(geometry:"source", value:5V, z:50Ω)
        }
        results:{
            allS11:S11(frequency:{from:2.3GHz, to:2.5GHz, count:5})
        }
    )
}

// --------------------------------------------------
// OpenEMS FDTD Simulation
// --------------------------------------------------

page{
    open-ems-solver(
        name:"oemsresult"
        geometry:"antenna-patch"
        frequency:f
        timesteps:30000
        endcriteria:1e-4
        results:{
            allS11:S11(frequency:{from:2.3GHz, to:2.5GHz, count:5})
        }
    )
}

// --------------------------------------------------
// Comparison Plot: Hadruwaves (MoM) vs OpenEMS (FDTD)
// --------------------------------------------------

page{
    plot2d{
        curve{
            x: hresult.allS11.x
            y: hresult.allS11.y
            title:"Hadruwaves MoM"
            color:blue
        }
        curve{
            x: oemsresult.allS11.x
            y: oemsresult.allS11.y
            title:"OpenEMS FDTD"
            color:red
        }
    }
}
