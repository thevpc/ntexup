import(
    common-functions
    plantuml
    animated-gif
    svg
    shapes2d
    shapes3d
    plot2d
    presenters
    latex
    hadruwaves
)

// --- Antenna Parameters (2.4 GHz on FR-4) ---
f  = 2.4GHz
εr = 4.4
h  = 1.6mm
h0  = 0.1mm

// --- Antenna Parameters (2.4 GHz on FR-4) ---
W  = 38.0mm   // Now the dimension along Y
L  = 29.45mm  // Now the dimension along X (radiating dimension)
w  = 3.05mm   // Feed Line Width (now a Y-dimension)
y0 = 9.3mm    // Inset Depth (now along X)
g  = 1.0mm    // Gap width
s  = 1.0mm    // Source width

// Box/Substrate dimensions
box_w = 80mm
box_l = 80mm


az  = 0.01mm    // z offset to draw arrows

page(bg:Gray90){
    styles:{
        text:{ color:darkBlue }
        line:{ color:black }
        ".substrate":{ bg:gray80 }
        ".copper":{ bg:copper }
        ".source":{ bg:yellow }
        ".dim-arrow":{
            start-arrow: simple()
            end-arrow: simple()
            stroke: basic(dashed)
            line-color:darkBlue
        }
    }
        scene3d(
            name: "antenna-a"
            draw-contour,
            transform:{
                translate(0,20,0)
                scale:0.9
            },
            real-size:(box_w,box_l,20mm)
            real-position:(-(box_w/2),-(box_l/2),0mm)
            size:(100,100) // 100% of the allocated 2D area from parent, aka all of it
            origin:(0,0)
        ){
            // 1. Substrate & Ground
            @(substrate) box(size: (box_w, box_l, h), position: (0, 0, -h),contour-color:red
//                bottom:{visible:false}
//                left:{visible:false}
//                right:{visible:false}
//                front:{visible:false}
//                back:{visible:false}
            )

            // 2. The Inset-Fed Patch
            @(copper) polygon(
                name:"antenna"
                points: [
                        // Start at the left edge of the substrate (Feed Line)
                        (-box_w/2, -w/2, 0), (-box_w/2, w/2, 0),
                        // Entering the notch from the left
                        (-L/2 + y0, w/2, 0), (-L/2 + y0, w/2 + g, 0),
                        // Top-left corner of the patch
                        (-L/2, w/2 + g, 0), (-L/2, W/2, 0),
                        // Far right edge
                        (L/2, W/2, 0), (L/2, -W/2, 0),
                        // Bottom-left corner of the patch
                        (-L/2, -W/2, 0), (-L/2, -w/2 - g, 0),
                        // Bottom notch
                        (-L/2 + y0, -w/2 - g, 0), (-L/2 + y0, -w/2, 0)
                    ]
            )

            // --- Optimized Dimension Arrows ---

            // L: Pushed higher to avoid W dimension
            @(dim-arrow) line(from:(-L/2, W/2 + 5mm, az), to:(L/2, W/2 + 5mm, az)){
                text("L=$L", font-size:2.5%P, position:(50, -130%))
            }

            // W: Moved further right
            @(dim-arrow) line(from:(L/2 + 5mm, -W/2, az), to:(L/2 + 5mm, W/2,  az)){
                text("W=$W", font-size:2.5%P, position:(130%, 50))
            }

            // y0: Depth along the feed line
            @(dim-arrow) line(from:(-L/2, -w/2 - 5mm, az), to:(-L/2 + y0, -w/2 - 5mm, az)){
                text("y0=$y0", font-size:2%P, position:(50, 160%))
            }

            // w: Feed line width at edge
            @(dim-arrow) line(from:(-box_w/2 - 2mm, -w/2, az), to:(-box_w/2- 2mm, w/2, az)){
                text("w=$w", font-size:2%P, position:(-160%, 50))
            }

            // h: Substrate thickness — front-right corner, visible in 3D
            @(dim-arrow) line(from:(-box_w/2 - 3mm, box_l/2, 0), to:(-box_w/2 - 3mm, box_l/2, -h)) {
                text("h=$h", font-size:2%P, position:(-160%, 50))
            }

            // f_l: Feed line length — from substrate edge to patch left edge, below feed line
            @(dim-arrow) line(from:(-box_w/2, -w/2 - 5mm, az), to:(-L/2, -w/2 - 5mm, az)) {
                text("f_l", font-size:2%P, position:(50, 160%))
            }

        }
}

page{
    hadruwaves-mom-solver(
        name:"hresult"
        geometry:"antenna-a"
        box-walls: EEEE // all Electric walls
        mode-functions-count: 1000 // all Electric walls
        basis-functions: {
            rwg(geometry:"antenna", count:10)
        },
        compute:{
            S11:sweepFrequency(from:2.3_GHz,to 2.5_GHz, count:10)
        }
    )
