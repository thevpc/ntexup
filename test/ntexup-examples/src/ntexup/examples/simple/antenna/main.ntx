import(
    "common-functions"
    "plantuml"
    "animated-gif"
    "svg"
    "shapes2d"
    "shapes3d"
    "plot2d"
    "presenters"
    "latex"
)
//include ("subfolder")

// --- Antenna Parameters (2.4 GHz on FR-4) ---
f  = 2.4GHz
εr = 4.4
h  = 1.6mm

W  = 38.0mm   // Patch Width
L  = 29.45mm  // Patch Length
w  = 3.05mm   // 50 Ohm Feed Line Width
y0 = 9.3mm    // Inset Depth (The "stabbing" distance)
g  = 1.0mm    // Gap width of the notch

// Box/Substrate dimensions
box_w = 80mm
box_l = 80mm

page{
    styles:{
        text:{ color:darkBlue }
        line:{ color:black }
        ".substrate":{ background:"#00468B" }
        ".copper":{ background:"#cb6d51" }
        ".source":{ background:yellow }
        ".dim-arrow":{
            start-arrow: simple()
            end-arrow: simple()
            stroke: basic(dashed)
        }
    }
        rectangle(background:Gray90)
        scene3d(
            name: "antenna-a"
            draw-contour,
            transform:{
                translate(0,-25,0)
                scale:0.9
            },
            real-size:(box_w,box_l,20mm)
            real-position:(0mm,-(box_l/2),0mm)
            size:(100,100) // 100% of the allocated 2D area from parent, aka all of it
            origin:(0,0)
        ){
//            box(
//                size:(200mm,200mm,10mm)
//                position(0mm,0mm,-10mm)
//                color:Caramel
//                left:{color:Brown}
//                front:{color:Brown}
//            )
            polygon(points:[(0mm,90mm,0mm),(100mm,90mm,0mm),(100mm,110mm,0mm),(0mm,110mm,0mm)],color:brown)

            // example of arrow for the vars
            @dim-arrow line(from:(0mm,90mm,0mm),to:(100mm,90mm,0mm)){
                text("w", font-size:3%P , origin:(50,50), position:(50,-2%P)) // aka 50% of the line and -2% of the page
            }

        }
}
