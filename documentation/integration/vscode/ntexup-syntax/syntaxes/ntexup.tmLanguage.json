{
  "name": "NTexUp",
  "scopeName": "source.ntexup",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#attributes" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ntexup",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ntexup",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ntexup",
          "match": "\\b(page|rectangle|ellipse|arc|stack)\\b"
        },
        {
          "name": "keyword.other.ntexup",
          "match": "\\b(styles|template|color|rotate|origin|position|font-size|font-family|font-bold)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ntexup",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.ntexup",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ntexup",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ntexup",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ntexup",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ntexup",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "variable.parameter.attribute.ntexup",
          "begin": "\\[\\[",
          "end": "\\]\\]",
          "patterns": [
            { "name": "string.quoted.double.ntexup", "begin": "\"", "end": "\"" }
          ]
        }
      ]
    }
  }
}
